# SWAG MCP Server Configuration
# This file contains example configuration values for the SWAG MCP server

# ========================================
# CORE SETTINGS (Required)
# ========================================

# Container path where SWAG proxy configurations are mounted.
# For Docker Compose, keep this as /proxy-confs and set the host bind path
# with SWAG_MCP_PROXY_CONFS_HOST_PATH below.
SWAG_MCP_PROXY_CONFS_PATH=/proxy-confs

# Remote SWAG server URI (optional - overrides PROXY_CONFS_PATH if set)
# Supports SSH: [user@]host[:port]:/path/to/proxy-confs
# Examples:
#   Local container path (same as SWAG_MCP_PROXY_CONFS_PATH): /proxy-confs
#   Remote: swag-server:/mnt/appdata/swag/nginx/proxy-confs
#   Remote with user: admin@swag-server:/mnt/appdata/swag/nginx/proxy-confs
#   Remote with port: swag-server:2222:/mnt/appdata/swag/nginx/proxy-confs
# Requires SSH keys to be configured for passwordless access
# SWAG_MCP_PROXY_CONFS_URI=

# Base path for SWAG log files on the SWAG server (local or remote)
# Used for the 'logs' action to read nginx, fail2ban, letsencrypt logs
SWAG_MCP_SWAG_LOG_BASE_PATH=/swag/log

# Directory for SWAG MCP server logs
# This directory will be created if it doesn't exist
SWAG_MCP_LOG_DIRECTORY=/app/.swag-mcp/logs

# ========================================
# SERVER SETTINGS
# ========================================

# SWAG_MCP_TOKEN enables built-in static bearer-token authentication for direct
# MCP server access. If no token or FASTMCP_SERVER_AUTH provider is configured,
# startup fails unless SWAG_MCP_NO_AUTH=true is set explicitly.
# Generate a token with: openssl rand -hex 32
SWAG_MCP_TOKEN=

# Public MCP endpoint used by HTTP smoke tests and remote MCP clients.
# Include the MCP mount path exactly once.
SWAG_MCP_URL=https://swag.example.com/mcp

# Set true only for loopback-only, stdio, or proxy-isolated deployments.
SWAG_MCP_NO_AUTH=false

# Optional FastMCP Google OAuth provider. When SWAG_MCP_TOKEN and OAuth are both
# configured, either a matching static bearer token or a valid OAuth token works.
FASTMCP_SERVER_AUTH=
FASTMCP_SERVER_AUTH_GOOGLE_CLIENT_ID=
FASTMCP_SERVER_AUTH_GOOGLE_CLIENT_SECRET=
FASTMCP_SERVER_AUTH_GOOGLE_BASE_URL=https://swag.example.com/mcp
FASTMCP_SERVER_AUTH_RESOURCE_BASE_URL=https://swag.example.com
FASTMCP_SERVER_AUTH_GOOGLE_REQUIRED_SCOPES=openid,email
FASTMCP_SERVER_AUTH_GOOGLE_REDIRECT_PATH=/auth/callback

# Host interface for the MCP server to bind to.
# Inside a Docker container this is forced to 0.0.0.0 regardless of this
# setting (Docker's network namespace provides isolation). When running
# outside Docker, set to 127.0.0.1 to restrict to loopback only.
SWAG_MCP_HOST=0.0.0.0

# Docker host bind address for the published MCP port.
SWAG_MCP_BIND_ADDRESS=127.0.0.1

# External port mapping for Docker/Compose (container always runs on port 8000 internally)
# This controls the host port that maps to container port 8000
SWAG_MCP_PORT=49152

# Docker image used by Compose. Keep SWAG_MCP_VERSION aligned with release manifests.
SWAG_MCP_VERSION=1.1.6
SWAG_MCP_IMAGE=ghcr.io/jmagar/swag-mcp:${SWAG_MCP_VERSION}
SWAG_MCP_PULL_POLICY=missing

# External Docker network used by Compose. `just up` validates or creates it.
DOCKER_NETWORK=swag-mcp

# Docker Compose host bind paths
PUID=1000
PGID=1000
SWAG_MCP_LOG_HOST_PATH=/tmp/swag-mcp/logs
SWAG_MCP_PROXY_CONFS_HOST_PATH=/mnt/appdata/swag/nginx/proxy-confs
SWAG_MCP_NGINX_INCLUDES_HOST_PATH=./config/nginx
SWAG_MCP_FASTMCP_DATA_HOST_PATH=/mnt/appdata/swag-mcp/data

# App-specific SSH directory for remote SWAG access.
# Copy only the key and known_hosts entries this service needs into this path.
SWAG_MCP_SSH_HOST_PATH=./.cache/swag-mcp/ssh

# ========================================
# DEFAULT CONFIGURATION
# ========================================

# Default authentication method for generated SWAG web endpoints.
# This is not MCP server authentication; MCP server auth is controlled by
# SWAG_MCP_TOKEN and FASTMCP_SERVER_AUTH above.
# Options: none, basic, ldap, authelia, authentik, tinyauth, oauth
# WARNING: 'none' exposes services without authentication!
SWAG_MCP_DEFAULT_WEB_AUTH_METHOD=authelia

# Enable QUIC support by default for new configurations
SWAG_MCP_DEFAULT_QUIC_ENABLED=false

# OAuth gateway settings used in generated SWAG MCP proxy configs
SWAG_MCP_OAUTH_UPSTREAM=http://mcp-oauth:8000
SWAG_MCP_AUTH_SERVER_URL=https://mcp-auth.example.com

# ========================================
# BACKUP SETTINGS
# ========================================

# Number of days to retain backup files
# Backups older than this will be cleaned up automatically
SWAG_MCP_BACKUP_RETENTION_DAYS=30

# ========================================
# LOGGING SETTINGS
# ========================================

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
SWAG_MCP_LOG_LEVEL=INFO

# Enable file logging in addition to console output
SWAG_MCP_LOG_FILE_ENABLED=true

# Fail container startup if the configured log directory is not writable.
# This prevents silent degradation from file+console logging to console-only logging.
SWAG_MCP_REQUIRE_WRITABLE_LOG_DIRECTORY=true

# Maximum size of log files before rotation (in bytes)
# Default: 10485760 = 10MB
SWAG_MCP_LOG_FILE_MAX_BYTES=10485760

# Number of rotated log file backups to retain
SWAG_MCP_LOG_FILE_BACKUP_COUNT=5

# Docker stdout/stderr log rotation for the container log driver
SWAG_MCP_DOCKER_LOG_MAX_SIZE=10m
SWAG_MCP_DOCKER_LOG_MAX_FILE=5

# Enable structured JSON logging (for log aggregation)
SWAG_MCP_ENABLE_STRUCTURED_LOGGING=false

# Include request/response payloads in logs (for debugging)
SWAG_MCP_LOG_PAYLOADS=false

# Maximum length of logged payloads
SWAG_MCP_LOG_PAYLOAD_MAX_LENGTH=1000

# ========================================
# PERFORMANCE SETTINGS
# ========================================

# Threshold for slow operation warnings (in milliseconds)
SWAG_MCP_SLOW_OPERATION_THRESHOLD_MS=1000

# Enable automatic retry middleware for failed operations
SWAG_MCP_ENABLE_RETRY_MIDDLEWARE=true

# Maximum number of retries for failed operations
SWAG_MCP_MAX_RETRIES=3

# ========================================
# HEALTH CHECK SETTINGS
# ========================================

# Disable SSL certificate verification for health checks
# WARNING: Only enable this for development or internal networks with self-signed certificates
# Setting to 'true' disables SSL verification (not recommended for production)
SWAG_MCP_HEALTH_CHECK_INSECURE=false

# ========================================
# RATE LIMITING (Optional)
# ========================================

# Enable rate limiting middleware
# Helps protect against abuse and ensures fair usage
SWAG_MCP_RATE_LIMIT_ENABLED=false

# Rate limit: requests per second
SWAG_MCP_RATE_LIMIT_RPS=10.0

# Rate limit: burst capacity
# Allow brief spikes above the RPS limit
SWAG_MCP_RATE_LIMIT_BURST=20

# ========================================
# ADVANCED SETTINGS
# ========================================

# Template path (usually doesn't need to be changed)
SWAG_MCP_TEMPLATE_PATH=templates
